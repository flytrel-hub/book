@startuml

!theme plain

title Book Library — Microservices Architecture

package "Client" {
    [Web Browser] as Web
}

package "API Gateway (Nginx :80)" {
    [Nginx] as Gateway
}

package "Microservices" {
    [Authors Service\nNode.js :3001] as AuthorsSvc
    [Categories Service\nNode.js :3002] as CategoriesSvc
    [Books Service\nNode.js :3003] as BooksSvc
}

package "Databases (PostgreSQL)" {
    database "authors-db" as PgAuthors
    database "categories-db" as PgCategories
    database "books-db" as PgBooks
}

Web --> Gateway : HTTP
Gateway --> AuthorsSvc : /api/authors
Gateway --> CategoriesSvc : /api/categories
Gateway --> BooksSvc : /api/books

AuthorsSvc --> PgAuthors
CategoriesSvc --> PgCategories
BooksSvc --> PgBooks

note right of Gateway
  Nginx routes:
  /api/authors → authors:3001
  /api/categories → categories:3002
  /api/books → books:3003
  / → static HTML
end note

@enduml
